<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.Widget.Panel"
        android:supportsRtl="true">
        <activity
            android:name=".WidgetActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.scalableui.widgets.apps.widget"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:theme="@style/Theme.Widget.Panel">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.scalableui.widgets.apps.main"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:theme="@style/Theme.Widget.Panel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_AUTOMOTIVE" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
