<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget" parent="@android:style/TextAppearance" />

    <style name="Widget.Header">
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Hero">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Time">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">60sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Stat">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Caption">
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Label">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.TileTitle">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
