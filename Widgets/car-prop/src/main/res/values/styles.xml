<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Title" parent="@android:style/TextAppearance">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Hero" parent="@android:style/TextAppearance">
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Label" parent="@android:style/TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/widget_muted</item>
    </style>
    <style name="Widget.Chip" parent="@android:style/TextAppearance">
        <item name="android:background">@drawable/widget_chip_bg</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/widget_chip_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
