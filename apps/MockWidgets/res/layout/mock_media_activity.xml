<?xml version="1.0" encoding="utf-8"?>
<!-- Compact media card for LauncherRRO (~464×284 dp). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/media_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now playing"
            android:textAllCaps="true"
            android:textColor="@color/glass_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:includeFontPadding="false"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/media_cover_bg">
                <ImageView
                    android:id="@+id/album_art_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    android:tint="@color/glass_text_secondary"
                    android:contentDescription="Album art"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/track_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Starlight Symphony"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-light"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/artist_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nebula Waves"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>

        <SeekBar
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:max="100"
            android:progress="42"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressTint="@color/glass_accent"
            android:thumb="@drawable/seekbar_thumb_none"
            android:splitTrack="false"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_skip_previous"
                android:scaleType="center"
                android:contentDescription="Previous track"
                android:tint="@color/glass_text_primary"
                android:padding="12dp"/>

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/widget_play_btn"
                android:src="@drawable/ic_pause"
                android:scaleType="center"
                android:contentDescription="Play or pause"
                android:tint="@color/glass_text_primary"
                android:padding="16dp"/>

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_skip_next"
                android:scaleType="center"
                android:contentDescription="Next track"
                android:tint="@color/glass_text_primary"
                android:padding="12dp"/>

            <!-- Kept for activity wiring; not shown in the compact card. -->
            <Button
                android:id="@+id/btn_focus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="Focus"/>

            <Button
                android:id="@+id/btn_fullscreen"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="Fullscreen"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
