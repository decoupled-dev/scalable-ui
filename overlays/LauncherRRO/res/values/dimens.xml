<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Safe area reported to the map. Bounds stay full-screen.
         Zero while the system bars are hidden. Grow a side when a card covers it. -->
    <!-- Widget column sits on the right. 528dp clears it and the zoom control beside it. -->
    <dimen name="launcher_map_inset_left">0dp</dimen>
    <!-- Clears the three status pills (bar height is 80dp). -->
    <dimen name="launcher_map_inset_top">80dp</dimen>
    <dimen name="launcher_map_inset_right">528dp</dimen>
    <!-- Dock top sits 96dp above the bottom edge. 108dp clears it by 12dp. -->
    <dimen name="launcher_map_inset_bottom">108dp</dimen>
    <!-- 240 dpi canvas is about 1707 x 1067 dp. Center on 50% / 100%. -->
    <!-- Negative so left sits left of center and right sits right of center. -->
    <dimen name="launcher_dock_half_width">-120dp</dimen>
    <dimen name="launcher_dock_bottom_margin">16dp</dimen>
    <dimen name="launcher_dock_top_offset">-96dp</dimen>
    <dimen name="launcher_status_half_width">-188dp</dimen>
    <dimen name="launcher_status_top">8dp</dimen>
    <dimen name="launcher_status_bottom">72dp</dimen>
    <!-- Three header pills. Height is 64dp so a 32dp corner is a capsule. -->
    <dimen name="launcher_pill_top">8dp</dimen>
    <dimen name="launcher_pill_bottom">72dp</dimen>
    <dimen name="launcher_pill_edge">16dp</dimen>
    <!-- 16dp from the left edge through the four status icons. -->
    <dimen name="launcher_pill_left_right">252dp</dimen>
    <!-- Negative so the clock sits across the center. -->
    <dimen name="launcher_pill_center_half">-96dp</dimen>
    <!-- Negative so the profile pill sits in from the right edge. -->
    <dimen name="launcher_pill_right_inset">-248dp</dimen>
    <dimen name="launcher_climate_left_left">16dp</dimen>
    <dimen name="launcher_climate_left_right">216dp</dimen>
    <dimen name="launcher_climate_right_left">1064dp</dimen>
    <dimen name="launcher_climate_right_right">1264dp</dimen>
    <!-- App grid is the right half, inset from the top, bottom, and edges. -->
    <dimen name="launcher_app_grid_top">88dp</dimen>
    <dimen name="launcher_app_grid_bottom_offset">120dp</dimen>
    <dimen name="launcher_app_grid_edge">16dp</dimen>
    <dimen name="launcher_app_grid_corner">28dp</dimen>
    <!-- Matches MockWidgets glass_panel so the window clip and the card stroke meet. -->
    <dimen name="launcher_widget_corner">48dp</dimen>
    <!-- Launched apps float at 90% width: 5% of the canvas on each side. -->
    <dimen name="launcher_app_corner">32dp</dimen>
    <!-- Closed copy sits just off the right edge, same width as the open panel. -->
    <dimen name="launcher_app_grid_closed_right_offset">-860dp</dimen>
    <!-- While the grid is open, widgets are gone. The right inset keeps map
         chrome in the uncovered left half. -->
    <dimen name="launcher_map_inset_left_apps">24dp</dimen>
    <dimen name="launcher_map_inset_right_apps">880dp</dimen>
    <!-- Past the right edge while the app grid covers that side.
         leftOffset is added; rightOffset is subtracted. -->
    <dimen name="launcher_widget_offscreen_left">36dp</dimen>
    <dimen name="launcher_widget_offscreen_right">-500dp</dimen>
    <!-- Three equal cards on the right edge, above the passenger climate pill.
         Inner edge is 480dp in; outer edge keeps a 16dp margin. -->
    <dimen name="launcher_widget_left">-480dp</dimen>
    <dimen name="launcher_widget_right">16dp</dimen>
    <!-- Below the status pill (ends at 72dp) and above the 108dp bottom inset
         on the 1067dp canvas. Three equal cards, 12dp apart. -->
    <dimen name="launcher_widget_climate_top">80dp</dimen>
    <dimen name="launcher_widget_climate_bottom">364dp</dimen>
    <dimen name="launcher_widget_media_top">376dp</dimen>
    <dimen name="launcher_widget_media_bottom">660dp</dimen>
    <dimen name="launcher_widget_stats_top">672dp</dimen>
    <dimen name="launcher_widget_stats_bottom">956dp</dimen>

    <!-- Stock status bar, drawn as the three top pills. -->
    <dimen name="car_top_system_bar_height">80dp</dimen>
    <!-- Quick-control popups fill the map between the pills and the dock. -->
    <dimen name="car_status_icon_panel_default_width">1674dp</dimen>
    <dimen name="car_profile_quick_controls_panel_width">1674dp</dimen>
    <dimen name="car_sensor_qc_panel_width">1674dp</dimen>
    <dimen name="launcher_qc_panel_min_height">840dp</dimen>
</resources>
