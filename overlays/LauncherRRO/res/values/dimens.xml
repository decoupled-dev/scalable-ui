    <dimen name="launcher_v2_below_top_in">1101.5dp</dimen>
    <dimen name="launcher_v2_below_bottom_in">1382.5dp</dimen>
    <dimen name="launcher_v3_widget_top_in">391.5dp</dimen>
    <dimen name="launcher_v3_widget_bottom_in">672.5dp</dimen>
    <dimen name="launcher_v3_w1_left_in">59.5dp</dimen>
