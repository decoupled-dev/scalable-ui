    <dimen name="launcher_widget_climate_bottom">364dp</dimen>
    <dimen name="launcher_widget_media_top">376dp</dimen>
    <dimen name="launcher_widget_media_bottom">660dp</dimen>
    <dimen name="launcher_widget_stats_top">672dp</dimen>
    <dimen name="launcher_widget_stats_bottom">956dp</dimen>
    <!-- Task windows sit inside the plate so its gray stroke reads like the dock. -->
    <dimen name="launcher_widget_task_corner">14.5dp</dimen>
    <dimen name="launcher_widget_left_in">-478.5dp</dimen>
    <dimen name="launcher_widget_right_in">17.5dp</dimen>
    <dimen name="launcher_widget_offscreen_left_in">37.5dp</dimen>
