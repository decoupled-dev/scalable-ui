<resources>
    <!-- 240 dpi canvas on 2560x1600 is about 1707 x 1067 dp. Percent bounds
         are the anchors; dp values are offsets from them. -->

    <!-- ===== Chrome geometry shared by the layouts ===== -->
    <!-- Capsule radius. At least half of any pill height, so both the 68dp
         header pills and the 84dp bottom pills render as true capsules. -->
    <dimen name="launcher_bar_corner">42dp</dimen>
    <!-- Header pills are 68dp tall; 34dp is their exact capsule radius. -->
    <dimen name="launcher_pill_corner">34dp</dimen>
    <!-- Light theme outline. values-night thins it to a hairline. -->
    <dimen name="launcher_stroke_width">1.5dp</dimen>
    <!-- Circular button in the dock and the temperature pills. -->
    <dimen name="launcher_dock_button_size">60dp</dimen>
    <!-- Half the 12dp gap between circles in the temperature pills. -->
    <dimen name="launcher_dock_button_margin">6dp</dimen>
    <!-- Half the 20dp gap between icons in the dock. -->
    <dimen name="launcher_dock_icon_margin">10dp</dimen>
    <!-- App icons already include their own plate. Fill the 60dp target. -->
    <dimen name="launcher_dock_icon_padding">0dp</dimen>
    <!-- Glyph inset inside the 60dp temperature circle: 30dp glyph. -->
    <dimen name="launcher_dock_button_padding">15dp</dimen>
    <!-- Pill end padding: with the 6dp margin the first circle sits 18dp in. -->
    <dimen name="launcher_bar_end_padding">12dp</dimen>
    <dimen name="launcher_dock_divider_width">1dp</dimen>
    <dimen name="launcher_dock_divider_height">30dp</dimen>
    <dimen name="launcher_dock_divider_margin">10dp</dimen>
    <!-- Flat glyph slot in the header pills: 30dp glyph on a 52dp target. -->
    <dimen name="launcher_status_button_size">52dp</dimen>
    <dimen name="launcher_status_button_padding">11dp</dimen>
    <!-- 20dp between 52dp slots puts 42dp of air between the 30dp glyphs. -->
    <dimen name="launcher_status_button_gap">20dp</dimen>
    <!-- With the slot inset the first glyph sits 24dp from the capsule end. -->
    <dimen name="launcher_status_pill_end_padding">14dp</dimen>
    <!-- Temperature readout between the two circles. -->
    <dimen name="launcher_temp_text_width">72dp</dimen>

    <!-- ===== Map safe area ===== -->
    <!-- Bounds stay full-screen. Insets keep map chrome clear of the pills,
         the widget column, and the dock. -->
    <dimen name="launcher_map_inset_left">0dp</dimen>
    <!-- Clears the three header pills (bottom edge 76dp). -->
    <dimen name="launcher_map_inset_top">84dp</dimen>
    <!-- Clears the widget column and the zoom control beside it. -->
    <dimen name="launcher_map_inset_right">528dp</dimen>
    <!-- Dock top sits 100dp above the bottom edge. 112dp clears it by 12dp. -->
    <dimen name="launcher_map_inset_bottom">112dp</dimen>
    <!-- While the grid is open, widgets are gone. The right inset keeps map
         chrome in the uncovered left half. -->
    <dimen name="launcher_map_inset_left_apps">24dp</dimen>
    <dimen name="launcher_map_inset_right_apps">880dp</dimen>

    <!-- ===== Header pills: 8dp from the top, 68dp tall ===== -->
    <dimen name="launcher_pill_top">8dp</dimen>
    <dimen name="launcher_pill_bottom">76dp</dimen>
    <!-- Screen-edge margin shared by every pill and the dock. -->
    <dimen name="launcher_pill_edge">16dp</dimen>
    <!-- Left pill fits five 52dp slots, four 20dp gaps, and 14dp end padding:
         16 + 260 + 80 + 28 = 384. -->
    <dimen name="launcher_pill_left_right">384dp</dimen>
    <!-- Clock pill is 152dp wide, centered. Negative: left of / right of 50%. -->
    <dimen name="launcher_pill_center_half">-76dp</dimen>
    <!-- Profile pill is 272dp wide: two 44dp privacy chip slots, a 12dp gap
         between them, the 32dp avatar, and a name up to 140dp. Negative so it
         sits in from the right edge. -->
    <dimen name="launcher_pill_right_inset">-288dp</dimen>
    <!-- Stock chip is 56dp with 24dp side padding, which clips the glyph. -->
    <dimen name="privacy_chip_width">44dp</dimen>
    <dimen name="privacy_chip_horizontal_padding">0dp</dimen>
    <dimen name="privacy_chip_vertical_padding">0dp</dimen>

    <!-- ===== Bottom row: dock and temperature pills, 84dp tall ===== -->
    <dimen name="launcher_dock_bottom_margin">16dp</dimen>
    <dimen name="launcher_dock_top_offset">-100dp</dimen>
    <!-- Eight 60dp icons with 20dp gaps (640), two divider blocks (42),
         and 12dp end padding on each side (24): 706dp with the recent slot
         and no pins. The first pin also adds the 21dp separator (101dp);
         each pin after that adds 80dp. Negative so the dock stays centered. -->
    <dimen name="launcher_dock_half_width">-353dp</dimen>
    <dimen name="launcher_dock_half_1">-404dp</dimen>
    <dimen name="launcher_dock_half_2">-444dp</dimen>
    <dimen name="launcher_dock_half_3">-484dp</dimen>
    <dimen name="launcher_dock_half_4">-524dp</dimen>
    <!-- Temperature pill: two 60dp circles, a 72dp readout, 12dp gaps and
         12dp end padding: 240dp. Left pill spans 16..256; the right pill
         mirrors it from the right edge. -->
    <dimen name="launcher_temp_pill_left_right">256dp</dimen>
    <dimen name="launcher_temp_pill_right_inset">-256dp</dimen>

    <!-- Layout variant 1, landscape only. The dock is a left rail. Status
         pills and both temperature pills share the bottom band, side by side. -->
    <!-- 16dp edge + 84dp rail. -->
    <dimen name="launcher_v1_dock_right">100dp</dimen>
    <!-- Driver temperature is 240dp, one margin past the rail: 116..356. -->
    <dimen name="launcher_v1_temp_left">116dp</dimen>
    <dimen name="launcher_v1_temp_left_right">356dp</dimen>
    <!-- Left status pill is 368dp, one gap past the driver pill. -->
    <dimen name="launcher_v1_pill_left_left">368dp</dimen>
    <dimen name="launcher_v1_pill_left_right">736dp</dimen>
    <!-- Profile pill is 272dp and ends 12dp before the passenger pill.
         Passenger pill occupies 100%-256 .. 100%-16. -->
    <dimen name="launcher_v1_pill_right_inset">-540dp</dimen>
    <dimen name="launcher_v1_pill_right_edge">268dp</dimen>
    <!-- 68dp status pill sitting 16dp off the bottom edge. -->
    <dimen name="launcher_v1_pill_top_offset">-84dp</dimen>
    <!-- Rail ends at 100dp; keep a 16dp gap. Opened apps use the same left edge. -->
    <dimen name="launcher_v1_map_inset_left">116dp</dimen>
    <dimen name="launcher_v1_app_left">116dp</dimen>
    <!-- Nothing sits on the top edge in this set. -->
    <dimen name="launcher_v1_map_inset_top">16dp</dimen>
    <!-- Temperature pills are 100dp tall from the bottom edge. -->
    <dimen name="launcher_v1_map_inset_bottom">112dp</dimen>

    <!-- ===== App grid and launched apps ===== -->
    <!-- App grid is the right half, inset from the top, bottom, and edges. -->
    <dimen name="launcher_app_grid_top">92dp</dimen>
    <dimen name="launcher_app_grid_bottom_offset">124dp</dimen>
    <dimen name="launcher_app_grid_edge">16dp</dimen>
    <dimen name="launcher_app_grid_corner">28dp</dimen>
    <!-- Launched apps fill the canvas. Side gaps match launcher_app_grid_edge. -->
    <dimen name="launcher_app_corner">32dp</dimen>
    <!-- Closed copy sits just off the right edge, same width as the open panel. -->
    <dimen name="launcher_app_grid_closed_right_offset">-860dp</dimen>

    <!-- ===== Widget column (hosted by com.test.design; bounds only) ===== -->
    <!-- Same 16dp corner as the app-side widget cards, so the window clip and the card meet. -->
    <dimen name="launcher_widget_corner">16dp</dimen>
    <!-- Past the right edge while the app grid covers that side.
         leftOffset is added; rightOffset is subtracted. -->
    <dimen name="launcher_widget_offscreen_left">36dp</dimen>
    <dimen name="launcher_widget_offscreen_right">-500dp</dimen>
    <!-- Three equal cards on the right edge, above the passenger climate pill.
