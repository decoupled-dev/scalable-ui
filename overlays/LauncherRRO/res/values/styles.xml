<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared chrome styles. Layouts here are inflated with the RRO package
  context, so these resolve inside the overlay without touching SystemUI.
-->
<resources>
    <!-- 60dp filled circle with a 30dp glyph. Dock and temperature pills. -->
    <style name="LauncherDockButton">
        <item name="android:layout_width">@dimen/launcher_dock_button_size</item>
        <item name="android:layout_height">@dimen/launcher_dock_button_size</item>
        <item name="android:layout_marginStart">@dimen/launcher_dock_button_margin</item>
        <item name="android:layout_marginEnd">@dimen/launcher_dock_button_margin</item>
        <item name="android:background">@drawable/launcher_dock_icon_bg</item>
        <item name="android:padding">@dimen/launcher_dock_button_padding</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Dock circles use a 20dp gap. Temperature pills keep the 12dp margin. -->
    <style name="LauncherDockIcon" parent="LauncherDockButton">
        <item name="android:layout_marginStart">@dimen/launcher_dock_icon_margin</item>
        <item name="android:layout_marginEnd">@dimen/launcher_dock_icon_margin</item>
    </style>

    <!-- Thin vertical rule between the system nav group and the shortcuts. -->
    <style name="LauncherDockDivider">
        <item name="android:layout_width">@dimen/launcher_dock_divider_width</item>
        <item name="android:layout_height">@dimen/launcher_dock_divider_height</item>
        <item name="android:layout_marginStart">@dimen/launcher_dock_divider_margin</item>
        <item name="android:layout_marginEnd">@dimen/launcher_dock_divider_margin</item>
        <item name="android:background">@color/launcher_stroke</item>
    </style>

    <!-- 52dp flat status glyph in the header pills, tinted to the surface text. -->
    <style name="LauncherStatusButton">
        <item name="android:layout_width">@dimen/launcher_status_button_size</item>
        <item name="android:layout_height">@dimen/launcher_status_button_size</item>
        <item name="android:background">@drawable/launcher_status_icon_bg</item>
        <item name="android:padding">@dimen/launcher_status_button_padding</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/launcher_on_surface</item>
    </style>

    <!-- Clock and temperature readouts. Medium weight reads cleaner than bold
         at 22sp on the capsule and matches the design app card titles. -->
    <style name="LauncherPillText">
        <item name="android:textColor">@color/launcher_on_surface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
