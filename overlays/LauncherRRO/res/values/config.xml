<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Map is the full-screen background (layer 2). Three decor pills sit
         on top: connectivity and display, the clock, and the user profile.
         Stock system bars stay off. The bottom dock replaces the nav bar.
         The right inset clears the climate, media, and driving-stats cards.
         The map bounds stay at 100%. -->
    <bool name="config_enableScalableUI">true</bool>
    <bool name="config_enableTopSystemBar">false</bool>
    <bool name="config_enableBottomSystemBar">false</bool>
    <bool name="config_enableLeftSystemBar">false</bool>
    <bool name="config_enableRightSystemBar">false</bool>

    <array name="window_states" translatable="false">
        <item>@xml/map_panel</item>
        <item>@xml/launcher_pill_left</item>
        <item>@xml/launcher_pill_center</item>
        <item>@xml/launcher_pill_right</item>
        <item>@xml/launcher_dock</item>
        <item>@xml/launcher_climate_left</item>
        <item>@xml/launcher_climate_right</item>
        <!-- Opaque plates under the three TaskPanels (layer 11) so the map
             cannot show through climate / media / stats in light or dark. -->
        <item>@xml/launcher_widget_climate_bg</item>
        <item>@xml/launcher_widget_media_bg</item>
        <item>@xml/launcher_widget_stats_bg</item>
        <item>@xml/launcher_widget_climate</item>
        <item>@xml/launcher_widget_media</item>
        <item>@xml/launcher_widget_stats</item>
        <item>@xml/panel_app_grid</item>
        <item>@xml/launcher_app</item>
    </array>

    <string-array name="config_default_activities" translatable="false">
        <item>map_panel;com.google.android.apps.maps/com.google.android.maps.MapsActivity</item>
        <item>launcher_climate;com.test.design/com.test.design.presentation.ivi.glanceables.ClimateHomePanelActivity</item>
        <item>launcher_media;com.android.car.mockwidgets/com.android.car.mockwidgets.MockMediaActivity</item>
        <item>launcher_stats;com.test.design/com.test.design.presentation.ivi.glanceables.VehicleHomePanelActivity</item>
    </string-array>
</resources>
