<?xml version="1.0" encoding="utf-8"?>
<!-- Capsule surface for every pill. Radius exceeds half the height of the
     64dp header pills and the 80dp bottom pills, so both render as true capsules. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/launcher_surface" />
    <corners android:radius="@dimen/launcher_bar_corner" />
    <stroke
        android:width="@dimen/launcher_stroke_width"
        android:color="@color/launcher_stroke" />
</shape>
