<?xml version="1.0" encoding="utf-8"?>
<!--
  App grid on the right half, with space above and below and rounded corners.
  Closed sits just off the right edge so TaskOpen slides it in. Home closes it.
-->
<TaskPanel id="panel_app_grid" defaultVariant="@id/closed" role="@string/appgrid_componentName" displayId="0">
    <!-- New tasks leave this half panel and open in launcher_app. -->
    <TaskBehavior newTaskLaunchPolicy="DEFAULT"/>
    <Variant id="@+id/base">
        <Layer layer="16"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/launcher_app_grid_corner"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/opened" parent="@id/base">
        <Visibility isVisible="true"/>
        <Focus onTransition="true"/>
        <Bounds
            left="50%"
            leftOffset="@dimen/launcher_app_grid_edge"
            top="@dimen/launcher_app_grid_top"
            right="100%"
            rightOffset="@dimen/launcher_app_grid_edge"
            bottom="100%"
            bottomOffset="@dimen/launcher_app_grid_bottom_offset"/>
    </Variant>
    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="true"/>
        <Bounds
            left="100%"
            top="@dimen/launcher_app_grid_top"
            right="100%"
            rightOffset="@dimen/launcher_app_grid_closed_right_offset"
            bottom="100%"
            bottomOffset="@dimen/launcher_app_grid_bottom_offset"/>
    </Variant>
    <Variant id="@+id/portrait_opened" parent="@id/opened">
        <Bounds
            left="@dimen/launcher_port_app_left"
            top="@dimen/launcher_port_app_top"
            right="@dimen/launcher_port_app_right"
            bottom="@dimen/launcher_port_app_bottom"/>
    </Variant>
    <Variant id="@+id/portrait_closed" parent="@id/closed">
        <Bounds
            left="@dimen/launcher_port_app_left"
            top="@dimen/launcher_port_app_closed_top"
            right="@dimen/launcher_port_app_right"
            bottom="@dimen/launcher_port_app_closed_bottom"/>
    </Variant>

    <!-- T-Rex uses the same card as configs 0 and 2. -->
    <Variant id="@+id/layout_v3_closed" parent="@id/closed"/>
    <Variant id="@+id/layout_v3_opened" parent="@id/opened"/>
    <Transitions>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/closed" toVariant="@id/opened" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/opened" toVariant="@id/opened" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/portrait_closed" toVariant="@id/portrait_opened" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/portrait_opened" toVariant="@id/portrait_opened" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_app" fromVariant="@id/opened" toVariant="@id/closed" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_app" fromVariant="@id/portrait_opened" toVariant="@id/portrait_closed" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/opened" toVariant="@id/closed" duration="450" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/portrait_opened" toVariant="@id/portrait_closed" duration="450" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=map_panel" fromVariant="@id/opened" toVariant="@id/closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=map_panel" fromVariant="@id/portrait_opened" toVariant="@id/portrait_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="toggle_fullscreen" fromVariant="@id/opened" toVariant="@id/closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="toggle_fullscreen" fromVariant="@id/portrait_opened" toVariant="@id/portrait_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/closed" toVariant="@id/closed" duration="0"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/opened" toVariant="@id/closed" duration="0"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/portrait_closed" toVariant="@id/portrait_closed" duration="0"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/portrait_opened" toVariant="@id/portrait_closed" duration="0"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/closed" toVariant="@id/portrait_closed" duration="0"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/opened" toVariant="@id/portrait_opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="orientation_landscape" fromVariant="@id/portrait_closed" toVariant="@id/closed" duration="0"/>
        <Transition onEvent="orientation_landscape" fromVariant="@id/portrait_opened" toVariant="@id/opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_3" fromVariant="@id/opened" toVariant="@id/layout_v3_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_3" fromVariant="@id/closed" toVariant="@id/layout_v3_closed" duration="0"/>
        <Transition onEvent="layout_variant_0" fromVariant="@id/layout_v3_opened" toVariant="@id/opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_0" fromVariant="@id/layout_v3_closed" toVariant="@id/closed" duration="0"/>
        <Transition onEvent="layout_variant_2" fromVariant="@id/layout_v3_opened" toVariant="@id/opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_2" fromVariant="@id/layout_v3_closed" toVariant="@id/closed" duration="0"/>
        <Transition onEvent="layout_variant_1" fromVariant="@id/layout_v3_opened" toVariant="@id/opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_1" fromVariant="@id/layout_v3_closed" toVariant="@id/closed" duration="0"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/layout_v3_opened" toVariant="@id/portrait_opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/layout_v3_closed" toVariant="@id/portrait_closed" duration="0"/>
        <Transition onEvent="trex_home" fromVariant="@id/layout_v3_opened" toVariant="@id/layout_v3_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="trex_home" fromVariant="@id/layout_v3_closed" toVariant="@id/layout_v3_closed" duration="0"/>
        <Transition onEvent="trex_nav" fromVariant="@id/layout_v3_opened" toVariant="@id/layout_v3_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="trex_nav" fromVariant="@id/layout_v3_closed" toVariant="@id/layout_v3_closed" duration="0"/>
        <Transition onEvent="trex_vehicle" fromVariant="@id/layout_v3_opened" toVariant="@id/layout_v3_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="trex_vehicle" fromVariant="@id/layout_v3_closed" toVariant="@id/layout_v3_closed" duration="0"/>
        <Transition onEvent="trex_split" fromVariant="@id/layout_v3_opened" toVariant="@id/layout_v3_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="trex_split" fromVariant="@id/layout_v3_closed" toVariant="@id/layout_v3_closed" duration="0"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/layout_v3_closed" toVariant="@id/layout_v3_opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/layout_v3_opened" toVariant="@id/layout_v3_opened" duration="0"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_app" fromVariant="@id/layout_v3_opened" toVariant="@id/layout_v3_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_climate_app" fromVariant="@id/layout_v3_opened" toVariant="@id/layout_v3_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/layout_v3_opened" toVariant="@id/layout_v3_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_settings_app" fromVariant="@id/layout_v3_opened" toVariant="@id/layout_v3_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
    </Transitions>
</TaskPanel>
