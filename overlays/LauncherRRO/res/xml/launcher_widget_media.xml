            left="100%"
            leftOffset="@dimen/launcher_widget_offscreen_left_in"
            top="@dimen/launcher_widget_media_top_in"
            right="100%"
            rightOffset="@dimen/launcher_widget_offscreen_right_in"
            bottom="@dimen/launcher_widget_media_bottom_in"/>
    </Variant>
    <Variant id="@+id/portrait" parent="@id/visible">
        <Bounds
            left="@dimen/launcher_port_w2_left_in"
            top="@dimen/launcher_port_widget_top_in"
            right="@dimen/launcher_port_w2_right_in"
            bottom="@dimen/launcher_port_widget_bottom_in"/>
    </Variant>
    <Variant id="@+id/portrait_apps_open" parent="@id/apps_open">
        <Bounds
            left="@dimen/launcher_port_w2_left_in"
            top="@dimen/launcher_port_widget_off_top_in"
            right="@dimen/launcher_port_w2_right_in"
            bottom="@dimen/launcher_port_widget_off_bottom_in"/>
    </Variant>
    <Variant id="@+id/layout_v2" parent="@id/visible">
        <Alpha alpha="1.0"/>
        <Bounds
            left="100%"
            leftOffset="@dimen/launcher_widget_left_in"
            top="@dimen/launcher_widget_media_top_in"
            right="100%"
            rightOffset="@dimen/launcher_widget_right_in"
            bottom="@dimen/launcher_widget_media_bottom_in"/>
    </Variant>
    <Variant id="@+id/wpage_1" parent="@id/layout_v2">
        <Alpha alpha="0.0"/>
        <Bounds
            left="100%"
            leftOffset="@dimen/launcher_widget_left_in"
            top="@dimen/launcher_v2_above_top_in"
            right="100%"
            rightOffset="@dimen/launcher_widget_right_in"
            bottom="@dimen/launcher_v2_above_bottom_in"/>
    </Variant>
    <Variant id="@+id/wpage_2" parent="@id/layout_v2">
        <Alpha alpha="0.0"/>
