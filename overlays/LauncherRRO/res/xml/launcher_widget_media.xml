            leftOffset="@dimen/launcher_widget_left_in"
            top="@dimen/launcher_widget_media_top_in"
            right="100%"
            rightOffset="@dimen/launcher_widget_right_in"
            bottom="@dimen/launcher_widget_media_bottom_in"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/visible" parent="@id/base">
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
    </Variant>
    <Variant id="@+id/hidden" parent="@id/base">
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
    </Variant>
    <Variant id="@+id/apps_open" parent="@id/base">
        <Visibility isVisible="true"/>
        <Alpha alpha="0.0"/>
