        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_settings_app" fromVariant="@id/portrait_opened" toVariant="@id/portrait_behind" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_1" fromVariant="@id/opened" toVariant="@id/layout_v1" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_1" fromVariant="@id/closed" toVariant="@id/layout_v1_closed" duration="0"/>
        <Transition onEvent="layout_variant_1" fromVariant="@id/behind" toVariant="@id/layout_v1_behind" duration="0"/>
        <Transition onEvent="layout_variant_0" fromVariant="@id/layout_v1" toVariant="@id/opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_2" fromVariant="@id/layout_v1" toVariant="@id/opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_0" fromVariant="@id/layout_v1_closed" toVariant="@id/closed" duration="0"/>
        <Transition onEvent="layout_variant_2" fromVariant="@id/layout_v1_closed" toVariant="@id/closed" duration="0"/>
        <Transition onEvent="layout_variant_0" fromVariant="@id/layout_v1_behind" toVariant="@id/behind" duration="0"/>
        <Transition onEvent="layout_variant_2" fromVariant="@id/layout_v1_behind" toVariant="@id/behind" duration="0"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/layout_v1" toVariant="@id/portrait_opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/layout_v1_closed" toVariant="@id/portrait_closed" duration="0"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/layout_v1_behind" toVariant="@id/portrait_behind" duration="0"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/layout_v1_closed" toVariant="@id/layout_v1" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/layout_v1_behind" toVariant="@id/layout_v1" duration="0"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_climate_app" fromVariant="@id/layout_v1" toVariant="@id/layout_v1_behind" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_settings_app" fromVariant="@id/layout_v1" toVariant="@id/layout_v1_behind" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
