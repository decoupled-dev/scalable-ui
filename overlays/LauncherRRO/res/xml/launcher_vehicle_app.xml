        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=map_panel" fromVariant="@id/layout_v1_behind" toVariant="@id/layout_v1_closed" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/layout_v1" toVariant="@id/layout_v1_closed" duration="450" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/layout_v1_behind" toVariant="@id/layout_v1_closed" duration="450" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/layout_v1" toVariant="@id/layout_v1_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/layout_v1_behind" toVariant="@id/layout_v1_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="toggle_fullscreen" fromVariant="@id/layout_v1" toVariant="@id/layout_v1_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="toggle_fullscreen" fromVariant="@id/layout_v1_behind" toVariant="@id/layout_v1_closed" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
