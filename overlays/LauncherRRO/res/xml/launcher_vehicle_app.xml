        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/layout_v1_behind" toVariant="@id/layout_v1_closed" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
