<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen map background. Cards are added later as higher-layer panels. -->
<overlay>
    <item target="bool/config_enableScalableUI" value="@bool/config_enableScalableUI"/>
    <item target="bool/config_enableTopSystemBar" value="@bool/config_enableTopSystemBar"/>
    <item target="bool/config_enableBottomSystemBar" value="@bool/config_enableBottomSystemBar"/>
    <item target="bool/config_enableLeftSystemBar" value="@bool/config_enableLeftSystemBar"/>
    <item target="bool/config_enableRightSystemBar" value="@bool/config_enableRightSystemBar"/>

    <item target="array/window_states" value="@array/window_states"/>
    <item target="array/config_default_activities" value="@array/config_default_activities"/>

    <item target="layout/car_top_system_bar" value="@layout/car_top_system_bar"/>
    <item target="layout/qc_bluetooth_panel" value="@layout/qc_bluetooth_panel"/>
    <item target="layout/qc_connectivity_panel" value="@layout/qc_connectivity_panel"/>
    <item target="layout/qc_display_panel" value="@layout/qc_display_panel"/>
    <item target="layout/qc_volume_panel" value="@layout/qc_volume_panel"/>
    <item target="layout/qc_profile_switcher" value="@layout/qc_profile_switcher"/>
