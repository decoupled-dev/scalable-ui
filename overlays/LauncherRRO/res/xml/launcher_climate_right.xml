<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-right passenger temperature. Panel id selects the passenger-zone layout. -->
<DecorPanel id="sysui_passenger_zone_panel" defaultVariant="@id/visible"
    controller="@xml/launcher_status_controller" displayId="0">
    <Variant id="@+id/base">
        <Layer layer="30"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/launcher_bar_corner"/>
        <Bounds
            left="100%"
            leftOffset="@dimen/launcher_temp_pill_right_inset"
            top="100%"
            topOffset="@dimen/launcher_dock_top_offset"
            right="100%"
            rightOffset="@dimen/launcher_pill_edge"
            bottom="100%"
            bottomOffset="@dimen/launcher_dock_bottom_margin"/>
        <Focus onTransition="true"/>
    </Variant>
    <Variant id="@+id/visible" parent="@id/base">
        <Visibility isVisible="true"/>
    </Variant>
    <Variant id="@+id/hidden" parent="@id/base">
        <Visibility isVisible="false"/>
    </Variant>
    <Variant id="@+id/portrait" parent="@id/base">
        <Visibility isVisible="true"/>
        <Bounds
            left="@dimen/launcher_port_temp_right_l"
            top="@dimen/launcher_port_temp_top"
            right="@dimen/launcher_port_temp_right_r"
            bottom="@dimen/launcher_port_temp_bottom"/>
    </Variant>
    <!-- Variant 1: passenger temperature stays on the bottom right. -->
    <Variant id="@+id/layout_v1" parent="@id/base">
        <Visibility isVisible="true"/>
        <Bounds
            left="100%"
            leftOffset="@dimen/launcher_temp_pill_right_inset"
            top="100%"
            topOffset="@dimen/launcher_dock_top_offset"
            right="100%"
            rightOffset="@dimen/launcher_pill_edge"
            bottom="100%"
            bottomOffset="@dimen/launcher_dock_bottom_margin"/>
    </Variant>

    <!-- T-Rex keeps this pill where config 0 puts it, with a 16dp corner. -->
    <Variant id="@+id/layout_v3" parent="@id/base">
        <Visibility isVisible="true"/>
        <Corner radius="@dimen/launcher_v3_pill_corner"/>
    </Variant>
    <Transitions>
        <Transition onEvent="_System_EnterSuwEvent" toVariant="@id/hidden"/>
        <Transition onEvent="_System_ExitSuwEvent" fromVariant="@id/hidden" toVariant="@id/visible"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/visible" toVariant="@id/portrait" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="orientation_landscape" fromVariant="@id/portrait" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_EnterSuwEvent" fromVariant="@id/portrait" toVariant="@id/hidden"/>
        <Transition onEvent="layout_variant_1" fromVariant="@id/visible" toVariant="@id/layout_v1" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_0" fromVariant="@id/layout_v1" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_2" fromVariant="@id/layout_v1" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/layout_v1" toVariant="@id/portrait" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_EnterSuwEvent" fromVariant="@id/layout_v1" toVariant="@id/hidden"/>
        <Transition onEvent="layout_variant_3" fromVariant="@id/visible" toVariant="@id/layout_v3" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_3" fromVariant="@id/layout_v1" toVariant="@id/layout_v3" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_3" fromVariant="@id/hidden" toVariant="@id/layout_v3" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_0" fromVariant="@id/layout_v3" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_1" fromVariant="@id/layout_v3" toVariant="@id/layout_v1" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="layout_variant_2" fromVariant="@id/layout_v3" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/layout_v3" toVariant="@id/portrait" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
    </Transitions>
</DecorPanel>
