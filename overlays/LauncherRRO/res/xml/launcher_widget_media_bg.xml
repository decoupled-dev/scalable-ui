<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque plate under launcher_media so the map cannot show through. -->
<DecorPanel id="launcher_widget_media_bg" defaultVariant="@id/visible"
    role="@layout/launcher_widget_card_bg" displayId="0">
    <Variant id="@+id/base">
        <Layer layer="11"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/launcher_widget_corner"/>
        <Bounds
            left="100%"
            leftOffset="@dimen/launcher_widget_left"
            top="@dimen/launcher_widget_media_top"
            right="100%"
            rightOffset="@dimen/launcher_widget_right"
            bottom="@dimen/launcher_widget_media_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/visible" parent="@id/base">
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
    </Variant>
    <Variant id="@+id/hidden" parent="@id/base">
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
    </Variant>
    <Variant id="@+id/apps_open" parent="@id/base">
        <Visibility isVisible="true"/>
        <Alpha alpha="0.0"/>
        <Bounds
            left="100%"
            leftOffset="@dimen/launcher_widget_offscreen_left"
            top="@dimen/launcher_widget_media_top"
            right="100%"
            rightOffset="@dimen/launcher_widget_offscreen_right"
            bottom="@dimen/launcher_widget_media_bottom"/>
    </Variant>
    <Variant id="@+id/portrait" parent="@id/visible">
        <Bounds
            left="@dimen/launcher_port_w2_left"
            top="@dimen/launcher_port_widget_top"
            right="@dimen/launcher_port_w2_right"
            bottom="@dimen/launcher_port_widget_bottom"/>
    </Variant>
    <Variant id="@+id/portrait_apps_open" parent="@id/apps_open">
        <Bounds
            left="@dimen/launcher_port_w2_left"
            top="@dimen/launcher_port_widget_off_top"
            right="@dimen/launcher_port_w2_right"
            bottom="@dimen/launcher_port_widget_off_bottom"/>
    </Variant>
    <Transitions>
        <Transition onEvent="_System_EnterSuwEvent" toVariant="@id/hidden"/>
        <Transition onEvent="_System_ExitSuwEvent" fromVariant="@id/hidden" toVariant="@id/visible"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/visible" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/hidden" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/apps_open" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/portrait" toVariant="@id/portrait_apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_app" fromVariant="@id/visible" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_app" fromVariant="@id/hidden" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_app" fromVariant="@id/apps_open" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_app" fromVariant="@id/portrait" toVariant="@id/portrait_apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_climate_app" fromVariant="@id/visible" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_climate_app" fromVariant="@id/hidden" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_climate_app" fromVariant="@id/apps_open" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_climate_app" fromVariant="@id/portrait" toVariant="@id/portrait_apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/visible" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/hidden" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/apps_open" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/portrait" toVariant="@id/portrait_apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_settings_app" fromVariant="@id/visible" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_settings_app" fromVariant="@id/hidden" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_settings_app" fromVariant="@id/apps_open" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=launcher_settings_app" fromVariant="@id/portrait" toVariant="@id/portrait_apps_open" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/apps_open" toVariant="@id/visible" duration="450" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/hidden" toVariant="@id/visible" duration="450" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_app" fromVariant="@id/apps_open" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_climate_app" fromVariant="@id/apps_open" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/apps_open" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_settings_app" fromVariant="@id/apps_open" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=map_panel" fromVariant="@id/apps_open" toVariant="@id/visible" duration="450" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="toggle_fullscreen" fromVariant="@id/visible" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="toggle_fullscreen" fromVariant="@id/hidden" toVariant="@id/apps_open" duration="400" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/visible" toVariant="@id/visible" duration="0"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/hidden" toVariant="@id/visible" duration="0"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/apps_open" toVariant="@id/visible" duration="0"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/portrait" toVariant="@id/portrait" duration="0"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/portrait_apps_open" toVariant="@id/portrait" duration="0"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/visible" toVariant="@id/portrait" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="orientation_portrait" fromVariant="@id/apps_open" toVariant="@id/portrait_apps_open" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="orientation_landscape" fromVariant="@id/portrait" toVariant="@id/visible" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="orientation_landscape" fromVariant="@id/portrait_apps_open" toVariant="@id/apps_open" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/portrait_apps_open" toVariant="@id/portrait" duration="450" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_app" fromVariant="@id/portrait_apps_open" toVariant="@id/portrait" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_climate_app" fromVariant="@id/portrait_apps_open" toVariant="@id/portrait" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_vehicle_app" fromVariant="@id/portrait_apps_open" toVariant="@id/portrait" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=launcher_settings_app" fromVariant="@id/portrait_apps_open" toVariant="@id/portrait" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=map_panel" fromVariant="@id/portrait_apps_open" toVariant="@id/portrait" duration="450" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="toggle_fullscreen" fromVariant="@id/portrait" toVariant="@id/portrait_apps_open" duration="400" interpolator="@android:anim/decelerate_interpolator"/>
        <Transition onEvent="_System_EnterSuwEvent" fromVariant="@id/portrait" toVariant="@id/hidden"/>
        <Transition onEvent="_System_EnterSuwEvent" fromVariant="@id/portrait_apps_open" toVariant="@id/hidden"/>
    </Transitions>
</DecorPanel>
