<?xml version="1.0" encoding="utf-8"?>
<!-- Right status pill: current user. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_user_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_dock_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="18dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/launcher_user_profile"
        android:src="@drawable/ic_status_profile"
        android:tint="@color/launcher_on_surface" />

    <TextView
        android:id="@+id/launcher_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/launcher_user_profile"
        android:textColor="@color/launcher_on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
