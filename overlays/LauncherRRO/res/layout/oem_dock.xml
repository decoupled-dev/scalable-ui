<?xml version="1.0" encoding="utf-8"?>
<!-- Layout name oem_dock: FooterController selects it when the panel id is oem_dock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_dock_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageButton
        android:id="@+id/sysui_nav_home"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/launcher_dock_icon_bg"
        android:backgroundTint="@color/launcher_dock_icon_fill"
        android:contentDescription="Home"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_dock_home" />

    <ImageButton
        android:id="@+id/sysui_footer_fullscreen_toggle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/launcher_dock_icon_bg"
        android:backgroundTint="@color/launcher_dock_icon_fill"
        android:contentDescription="Navigation"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_dock_nav" />

    <ImageButton
        android:id="@+id/sysui_nav_all_apps"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/launcher_dock_icon_bg"
        android:backgroundTint="@color/launcher_dock_icon_fill"
        android:contentDescription="Apps"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_dock_apps" />

    <ImageButton
        android:id="@+id/oem_launch_assistant"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/launcher_dock_icon_bg"
        android:backgroundTint="@color/launcher_dock_icon_fill"
        android:contentDescription="Assistant"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_dock_mic" />

    <ImageButton
        android:id="@+id/oem_launch_hvac"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/launcher_dock_icon_bg"
        android:backgroundTint="@color/launcher_dock_icon_fill"
        android:contentDescription="Climate"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_dock_climate" />

    <ImageButton
        android:id="@+id/oem_launch_vehicle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/launcher_dock_icon_bg"
        android:backgroundTint="@color/launcher_dock_icon_fill"
        android:contentDescription="Vehicle"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_dock_vehicle" />

    <ImageButton
        android:id="@+id/oem_launch_car_settings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/launcher_dock_icon_bg"
        android:backgroundTint="@color/launcher_dock_icon_fill"
        android:contentDescription="Car settings"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_dock_settings" />
</LinearLayout>
