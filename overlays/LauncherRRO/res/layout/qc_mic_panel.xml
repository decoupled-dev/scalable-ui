<?xml version="1.0" encoding="utf-8"?>
<!-- Stock microphone privacy panel, sized to the map area. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:systemui="http://schemas.android.com/apk/res-auto"
    android:id="@*com.android.systemui:id/mic_privacy_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="840dp"
    android:background="@*com.android.systemui:color/status_icon_panel_bg_color"
    android:layoutDirection="locale">

    <com.android.car.ui.FocusParkingView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.android.car.ui.FocusArea
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <com.android.systemui.car.qc.base.SystemUIQCView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                systemui:localQCProvider="com.android.systemui.car.systembar.privacy.mic.MicQcPanel"/>
        </ScrollView>

        <com.android.systemui.car.qc.footer.base.QCFooterButton
            android:id="@*com.android.systemui:id/qc_mic_footer_button"
            style="@*com.android.systemui:style/QCFooterButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@*com.android.systemui:string/privacy_chip_settings"
            systemui:disableWhileDriving="true"
            systemui:intent="intent:#Intent;action=android.settings.PRIVACY_SETTINGS;launchFlags=0x14000000;end"/>
    </com.android.car.ui.FocusArea>
</FrameLayout>
