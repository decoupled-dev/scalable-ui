<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback name the stock header controller asks for: clock plus theme toggle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_dock_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/launcher_pill_edge"
    android:paddingEnd="@dimen/launcher_status_pill_end_padding">

    <TextClock
        style="@style/LauncherPillText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:letterSpacing="0.02" />

    <ImageButton
        android:id="@+id/sysui_night_mode"
        style="@style/LauncherStatusButton"
        android:layout_marginStart="@dimen/launcher_status_button_gap"
        android:contentDescription="@string/launcher_dark_theme"
        android:src="@drawable/ic_status_night" />
</LinearLayout>
