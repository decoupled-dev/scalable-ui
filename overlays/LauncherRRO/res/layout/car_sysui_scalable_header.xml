<?xml version="1.0" encoding="utf-8"?>
<!-- Device header controller inflates this name for the status pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_dock_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="14dp">

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/launcher_on_surface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/sysui_night_mode"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/launcher_dark_theme"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_status_night"
        android:tint="@color/launcher_on_surface" />
</LinearLayout>
