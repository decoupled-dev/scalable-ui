<?xml version="1.0" encoding="utf-8"?>
<!-- Device header controller inflates this name for the status pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_dock_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="14dp">

    <TextClock
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/launcher_on_surface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Bluetooth"
        android:src="@drawable/ic_status_bluetooth"
        android:tint="@color/launcher_on_surface" />

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:contentDescription="Wi-Fi"
        android:src="@drawable/ic_status_wifi"
        android:tint="@color/launcher_on_surface" />
</LinearLayout>
