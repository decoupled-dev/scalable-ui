<?xml version="1.0" encoding="utf-8"?>
<!-- Left status pill: Wi-Fi, Bluetooth, brightness, day/night. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_dock_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageButton
        android:id="@+id/launcher_status_wifi"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/launcher_wifi"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_status_wifi"
        android:tint="@color/launcher_on_surface" />

    <ImageButton
        android:id="@+id/launcher_status_bluetooth"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/launcher_bluetooth"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_status_bluetooth"
        android:tint="@color/launcher_on_surface" />

    <ImageButton
        android:id="@+id/launcher_status_brightness"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/launcher_brightness"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_status_brightness"
        android:tint="@color/launcher_on_surface" />

    <ImageButton
        android:id="@+id/sysui_night_mode"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/launcher_dark_theme"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_status_night"
        android:tint="@color/launcher_on_surface" />
</LinearLayout>
