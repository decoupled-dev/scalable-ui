<?xml version="1.0" encoding="utf-8"?>
<!--
  Stock top bar, drawn as three pills over the map.
  Left: Bluetooth, Wi-Fi, brightness, volume, day/night.
  Center: clock and the stock read-only icons (location, call).
  Right: notifications, privacy chips, user profile.
  Each stock button still opens its quick-control panel.
-->
<com.android.systemui.car.systembar.base.CarSystemBarView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:systemui="http://schemas.android.com/apk/res-auto"
    android:id="@*com.android.systemui:id/car_top_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:background="@*com.android.systemui:drawable/rounded_bg_full"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <include
                layout="@*com.android.systemui:layout/qc_status_icons_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>

            <!-- Day/night lives on the stock display panel (theme toggle). -->
            <com.android.systemui.car.systembar.panel.CarSystemBarPanelButtonView
                android:id="@android:id/button1"
                android:layout_width="@*com.android.systemui:dimen/car_quick_controls_entry_points_button_width"
                android:layout_height="match_parent"
                android:contentDescription="@*com.android.systemui:string/status_icon_display_status"
                systemui:panelLayoutRes="@*com.android.systemui:layout/qc_display_panel">

                <ImageView
                    android:layout_width="@*com.android.systemui:dimen/car_quick_controls_icon_drawable_width"
                    android:layout_height="@*com.android.systemui:dimen/car_quick_controls_icon_drawable_height"
                    android:layout_gravity="center"
                    android:contentDescription="@*com.android.systemui:string/status_icon_display_status"
                    android:src="@*com.android.systemui:drawable/qs_light_dark_theme_icon_off"
                    android:tint="@*com.android.systemui:color/car_status_icon_color"/>
            </com.android.systemui.car.systembar.panel.CarSystemBarPanelButtonView>
        </LinearLayout>

        <LinearLayout
            android:id="@*com.android.systemui:id/clock_container"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@*com.android.systemui:drawable/rounded_bg_full"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="10dp">

            <com.android.systemui.statusbar.policy.Clock
                android:id="@*com.android.systemui:id/clock"
                style="@*com.android.systemui:style/SystemBarClockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@*com.android.systemui:color/car_status_icon_color"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <include
                layout="@*com.android.systemui:layout/read_only_status_icons"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:background="@*com.android.systemui:drawable/rounded_bg_full"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <com.android.systemui.car.systembar.base.CarSystemBarButton
                android:id="@*com.android.systemui:id/notifications"
                style="@*com.android.systemui:style/HorizontalBarButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@*com.android.systemui:string/system_bar_notifications_label"
                systemui:controller="com.android.systemui.car.notification.NotificationButtonController"
                systemui:highlightWhenSelected="true"
                systemui:icon="@*com.android.systemui:drawable/car_ic_notification_dock"
                systemui:longIntent="intent:#Intent;action=com.android.car.bugreport.action.BUG_REPORT;end"/>

            <include
                layout="@*com.android.systemui:layout/promoted_notification_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>

            <include
                layout="@*com.android.systemui:layout/share_to_app_privacy_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>

            <include
                layout="@*com.android.systemui:layout/cast_to_other_device_privacy_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>

            <include
                layout="@*com.android.systemui:layout/camera_privacy_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>

            <include
                layout="@*com.android.systemui:layout/mic_privacy_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>

            <include
                layout="@*com.android.systemui:layout/user_name_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </FrameLayout>
</com.android.systemui.car.systembar.base.CarSystemBarView>
