<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-right passenger temperature pill. Mirrors the driver pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sysui_passenger_zone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_dock_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/launcher_bar_end_padding"
    android:paddingEnd="@dimen/launcher_bar_end_padding">

    <ImageButton
        android:id="@+id/sysui_passenger_hvac_down"
        style="@style/LauncherDockButton"
        android:contentDescription="@string/launcher_temp_down"
        android:src="@drawable/ic_climate_minus" />

    <TextView
        android:id="@+id/sysui_passenger_hvac_temp"
        style="@style/LauncherPillText"
        android:layout_width="@dimen/launcher_temp_text_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/launcher_temp_placeholder" />

    <ImageButton
        android:id="@+id/sysui_passenger_hvac_up"
        style="@style/LauncherDockButton"
        android:contentDescription="@string/launcher_temp_up"
        android:src="@drawable/ic_climate_plus" />
</LinearLayout>
