<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom-left driver temperature pill.
  CarSysuiScalableHeaderController loads this name for panel id
  sysui_driver_zone_panel. The gone header keeps the minus button as the
  temperature step; without it the controller treats the first child as a card title.
  Circles match the dock so the whole bottom row reads as one family.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sysui_driver_zone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_dock_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/launcher_bar_end_padding"
    android:paddingEnd="@dimen/launcher_bar_end_padding">

    <View
        android:id="@+id/oem_card_header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/sysui_driver_hvac_down"
        style="@style/LauncherDockButton"
        android:contentDescription="@string/launcher_temp_down"
        android:src="@drawable/ic_climate_minus" />

    <TextView
        android:id="@+id/sysui_driver_hvac_temp"
        style="@style/LauncherPillText"
        android:layout_width="@dimen/launcher_temp_text_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/launcher_temp_placeholder" />

    <ImageButton
        android:id="@+id/sysui_driver_hvac_up"
        style="@style/LauncherDockButton"
        android:contentDescription="@string/launcher_temp_up"
        android:src="@drawable/ic_climate_plus" />
</LinearLayout>
