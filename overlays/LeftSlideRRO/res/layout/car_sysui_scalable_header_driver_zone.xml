<?xml version="1.0" encoding="utf-8"?>
<!-- Interactive OEM climate — wired by CarSysuiScalableHeaderController -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sysui_driver_zone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/oem_card_climate_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/oem_climate_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/oem_ic_fan" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="CLIMATE"
            android:textColor="#FF7EC8FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/oem_ic_more" />
    </LinearLayout>

    <TextView
        android:id="@+id/sysui_driver_hvac_temp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="19°"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <!-- Fan direction — wired to HVAC_FAN_DIRECTION via HeaderController. -->
        <ImageButton
            android:id="@+id/oem_vent_defrost"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/oem_ic_vent_windshield"
            android:background="@drawable/oem_climate_btn"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:contentDescription="Windshield" />

        <ImageButton
            android:id="@+id/oem_vent_face"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/oem_ic_vent_face"
            android:background="@drawable/oem_climate_btn"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:contentDescription="Face vents" />

        <ImageButton
            android:id="@+id/oem_vent_feet"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/oem_ic_vent_feet"
            android:background="@drawable/oem_climate_btn"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:contentDescription="Feet vents" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/oem_fan_bar"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/sysui_driver_hvac_down"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_sysui_hvac_down"
            android:background="@drawable/oem_climate_btn_flat"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/sysui_content_desc_hvac_down" />

        <ImageButton
            android:id="@+id/oem_fan_speed"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/oem_ic_fan"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:contentDescription="Fan speed" />

        <ImageButton
            android:id="@+id/sysui_driver_hvac_up"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_sysui_hvac_up"
            android:background="@drawable/oem_climate_btn_flat"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/sysui_content_desc_hvac_up" />
    </LinearLayout>

    <View
        android:id="@+id/sysui_header_ux_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/sysui_header_vhal_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
