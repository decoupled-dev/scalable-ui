<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HOME visibility barrier. Stock CarLauncher is not the home activity. -->
    <string name="launcher_home_component" translatable="false">com.android.car.stub.launcher/.StubHome</string>

    <!-- Panel role: Media card (ControlBarActivity in left column) -->
    <string name="media_componentName" translatable="false">com.android.car.carlauncher/.ControlBarActivity</string>

    <!-- Panel role: Full media app (opens in expanded media_source_panel) -->
    <string-array name="media_app_components" translatable="false">
    </string-array>

    <string-array name="app_panel_components" translatable="false">
        <item>com.poc.assistant/.LocalLLMActivity</item>
        <item>com.tcs.vehicleassistant/.LocalLLMActivity</item>
        <!-- com.test.design glanceables opened from home-screen widgets. -->
        <item>com.test.design/.presentation.ivi.glanceables.ClimatePanelActivity</item>
        <item>com.test.design/.presentation.ivi.glanceables.MediaPanelActivity</item>
        <item>com.test.design/.presentation.ivi.glanceables.VehiclePanelActivity</item>
        <item>com.test.design/.presentation.ivi.map.MapActivity</item>
        <item>com.test.design/.MainActivity</item>
        <!-- Media stays on the OEM media card — do not open MediaActivity over the map. -->
        <item>com.android.car.radio/.RadioActivity</item>
        <item>com.android.car.mockwidgets/.MockMediaActivity</item>
        <!-- Card deep-links: hosted in app_panel (bounds leave OEM dock free). -->
        <!-- Dialer stays on the OEM phone card — do not steal into app_panel. -->
        <!-- ClimateActivity is hosted by hvac_left_panel (slide-up), not app_panel. -->
        <item>com.android.car.mockwidgets/.DrivingStatsActivity</item>
        <!-- Prefer Spotify / active media app hosted in app_panel. -->
        <item>com.spotify.music/com.spotify.music.MainActivity</item>
        <item>com.android.car.media/.MediaDispatcherActivity</item>
        <item>com.android.car.media/.MediaActivity</item>
    </string-array>

    <!-- Panel role: Phone card — real Car Dialer (widget mode) + in-call. -->
    <string-array name="phone_components" translatable="false">
        <item>com.android.car.dialer/.ui.TelecomActivity</item>
        <item>com.android.car.dialer/.ui.activecall.InCallActivity</item>
    </string-array>

    <string name="oem_phone_component" translatable="false">com.android.car.dialer/.ui.TelecomActivity</string>

    <!-- Design IVI glanceables (com.test.design) — dock Climate / vehicle card. -->
