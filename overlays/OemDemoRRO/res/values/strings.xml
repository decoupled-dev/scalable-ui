    <string name="design_media_intent" translatable="false">intent:#Intent;action=com.test.design.action.OPEN_MEDIA;end</string>
    <string name="design_vehicle_intent" translatable="false">intent:#Intent;action=com.test.design.action.OPEN_VEHICLE;end</string>
    <string name="design_map_intent" translatable="false">intent:#Intent;action=com.test.design.action.OPEN_MAP;end</string>
