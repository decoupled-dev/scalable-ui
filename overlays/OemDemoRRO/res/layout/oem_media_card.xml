<?xml version="1.0" encoding="utf-8"?>
<!-- Compact media band (full-width short) — wired by CarSysuiScalableFooterController -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sysui_footer_media_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oem_card_media_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/sysui_media_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/album_cover_rhythm"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_album_bg"
            android:clipToOutline="true"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/oem_card_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/oem_media_open_app"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/oem_ic_music" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="MEDIA"
                        android:textColor="#FFE8B86D"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/oem_card_expand"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:src="@drawable/oem_ic_more"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Expand media" />
            </LinearLayout>

            <TextView
                android:id="@+id/sysui_media_track_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sysui_media_not_playing"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/sysui_media_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true" />

            <ProgressBar
                android:id="@+id/sysui_media_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progress="0"
                android:indeterminate="false"
                android:progressDrawable="@drawable/oem_media_progress" />

            <!-- Kept for controller resolve compatibility; hidden track/fill pair. -->
            <FrameLayout
                android:id="@+id/sysui_media_progress_track"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <View
                    android:id="@+id/sysui_media_progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sysui_media_position"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/sysui_media_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/sysui_media_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_sysui_media_prev"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/sysui_media_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_sysui_media_play"
                android:background="@drawable/oem_play_circle"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:contentDescription="Play pause" />

            <ImageButton
                android:id="@+id/sysui_media_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_sysui_media_next"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/sysui_media_ux_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/sysui_ux_scrim"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
