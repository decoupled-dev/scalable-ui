<?xml version="1.0" encoding="utf-8"?>
<!-- Passenger climate pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sysui_passenger_zone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical|end"
    android:background="@drawable/sysui_pill_background"
    android:paddingStart="8dp"
    android:paddingEnd="20dp">

    <ImageButton
        android:id="@+id/sysui_passenger_hvac_down"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_sysui_hvac_down"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sysui_content_desc_hvac_down"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/sysui_passenger_hvac_temp"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="22°"
        android:textColor="@color/sysui_bar_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/sysui_passenger_hvac_up"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_sysui_hvac_up"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sysui_content_desc_hvac_up"
        android:scaleType="centerInside"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/sysui_passenger_zone_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/sysui_zone_passenger_label"
        android:textColor="@color/sysui_zone_label_passenger"
        android:textSize="@dimen/sysui_zone_label_size"
        android:textAllCaps="true" />

</LinearLayout>
