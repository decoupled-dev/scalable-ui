<?xml version="1.0" encoding="utf-8"?>
<DecorPanel 
    id="floating_nav_panel" 
    role="floating_nav_role"
    defaultVariant="@id/visible" 
    controller="@xml/floating_nav_controller" 
    displayId="0">

    <Variant id="@+id/visible">
        <Layer layer="15"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="48dp"/>
        <Bounds left="510dp" top="930dp" right="1410dp" bottom="1050dp"/>
        <Focus onTransition="true"/>
    </Variant>

    <Variant id="@+id/hidden">
        <Layer layer="15"/>
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
        <Corner radius="48dp"/>
        <Bounds left="510dp" top="930dp" right="1410dp" bottom="1050dp"/>
        <Focus onTransition="false"/>
    </Variant>

    <Transitions>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" toVariant="@id/hidden" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/visible" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
    </Transitions>

</DecorPanel>
