<TaskPanel id="app_panel" defaultVariant="@id/closed" role="@array/app_panel_components" displayId="0">
    <!-- Cover map + cards only; bottom 700dp leaves oem_dock (708–800dp) touchable. -->
    <Variant id="@+id/opened">
        <Layer layer="15"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="32dp"/>
        <Bounds left="16dp" top="72dp" right="1264dp" bottom="700dp"/>
        <Focus onTransition="true"/>
    </Variant>
    <Variant id="@+id/fullscreen">
        <Layer layer="15"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="0dp"/>
        <Bounds left="0dp" top="0dp" right="1280dp" bottom="800dp"/>
        <Focus onTransition="true"/>
    </Variant>
    <Variant id="@+id/closed">
        <Layer layer="15"/>
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
        <Corner radius="32dp"/>
        <Bounds left="-600dp" top="84dp" right="0dp" bottom="700dp"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/page2_opened">
        <Layer layer="15"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="32dp"/>
        <Bounds left="-700dp" top="32dp" right="-32dp" bottom="640dp"/>
        <Focus onTransition="true"/>
    </Variant>
    <Transitions>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" toVariant="@id/opened" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" toVariant="@id/closed" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=settings_panel" toVariant="@id/closed" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=map_panel" toVariant="@id/closed" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=hvac_left_panel" toVariant="@id/closed" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/closed" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="show_page2" fromVariant="@id/opened" toVariant="@id/page2_opened" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_fullscreen" fromVariant="@id/opened" toVariant="@id/fullscreen" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_fullscreen" fromVariant="@id/fullscreen" toVariant="@id/opened" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
    </Transitions>
</TaskPanel>
