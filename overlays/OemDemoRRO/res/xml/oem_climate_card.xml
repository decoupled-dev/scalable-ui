<?xml version="1.0" encoding="utf-8"?>
<!-- Panel id sysui_driver_zone_panel so stock HeaderController loads climate layout. -->
<DecorPanel id="sysui_driver_zone_panel" defaultVariant="@id/visible"
    controller="@xml/sysui_scalable_header_controller" displayId="0">
    <Variant id="@+id/visible">
        <Layer layer="6"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="28dp"/>
        <!-- Phone-priority rail: Climate bottom-left compact. -->
        <Bounds left="712dp" top="560dp" right="984dp" bottom="700dp"/>
        <Focus onTransition="true"/>
    </Variant>
    <Variant id="@+id/expanded">
        <Layer layer="16"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="28dp"/>
        <Bounds left="712dp" top="72dp" right="1264dp" bottom="700dp"/>
        <Focus onTransition="true"/>
    </Variant>
    <Variant id="@+id/hidden">
        <Layer layer="6"/>
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
        <Corner radius="28dp"/>
        <Bounds left="712dp" top="560dp" right="984dp" bottom="700dp"/>
        <Focus onTransition="false"/>
    </Variant>
    <Transitions>
        <Transition onEvent="toggle_map_fullscreen" fromVariant="@id/visible" toVariant="@id/hidden" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_map_fullscreen" fromVariant="@id/hidden" toVariant="@id/visible" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_map_fullscreen" fromVariant="@id/expanded" toVariant="@id/hidden" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_climate" fromVariant="@id/visible" toVariant="@id/expanded" duration="350" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_climate" fromVariant="@id/expanded" toVariant="@id/visible" duration="350" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_media" fromVariant="@id/visible" toVariant="@id/hidden" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_media" fromVariant="@id/hidden" toVariant="@id/visible" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_media" fromVariant="@id/expanded" toVariant="@id/hidden" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_phone" fromVariant="@id/visible" toVariant="@id/hidden" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_phone" fromVariant="@id/hidden" toVariant="@id/visible" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_phone" fromVariant="@id/expanded" toVariant="@id/hidden" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_stats" fromVariant="@id/visible" toVariant="@id/hidden" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_stats" fromVariant="@id/hidden" toVariant="@id/visible" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="toggle_card_expand_stats" fromVariant="@id/expanded" toVariant="@id/hidden" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/hidden" toVariant="@id/visible" duration="0"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/expanded" toVariant="@id/visible" duration="300" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/visible" duration="0"/>
    </Transitions>
</DecorPanel>
